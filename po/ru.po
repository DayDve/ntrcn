#: src/ntrcn/diagnostics.py:44
#, python-brace-format
msgid "Dictionary for {label} ({name})"
msgstr "Словарь для {label} ({name})"

#: src/ntrcn/diagnostics.py:48
msgid "The layout's language is unknown: only the last word is fixed"
msgstr "Язык раскладки неизвестен: исправляется только последнее слово"

#: src/ntrcn/diagnostics.py:52
#, python-brace-format
msgid ""
"Without a dictionary only the last word is fixed. Download it or install a "
"package: {hint}"
msgstr ""
"Без словаря исправляется только последнее слово. Скачайте словарь или "
"установите пакет: {hint}"

#: src/ntrcn/diagnostics.py:60
msgid "Install the wl-clipboard package"
msgstr "Установите пакет wl-clipboard"

#: src/ntrcn/diagnostics.py:63
msgid "Reading keyboards"
msgstr "Чтение клавиатур"

#: src/ntrcn/diagnostics.py:65
msgid ""
"Add yourself to the input group and log in again: sudo usermod -aG input "
"$USER"
msgstr ""
"Добавьте себя в группу input и перезайдите: sudo usermod -aG input $USER"

#: src/ntrcn/diagnostics.py:68
msgid "Virtual keyboard (/dev/uinput)"
msgstr "Виртуальная клавиатура (/dev/uinput)"

#: src/ntrcn/diagnostics.py:71
#, python-brace-format
msgid ""
"Allow access with the udev rule: sudo install -m 644 {rule} /etc/udev/rules."
"d/ && sudo udevadm trigger /dev/uinput"
msgstr ""
"Разрешите доступ правилом udev: sudo install -m 644 {rule} /etc/udev/rules."
"d/ && sudo udevadm trigger /dev/uinput"

#: src/ntrcn/diagnostics.py:76
msgid "Reading the selection (wl-paste)"
msgstr "Чтение выделения (wl-paste)"

#: src/ntrcn/diagnostics.py:81
#, python-brace-format
msgid "Plasma layouts: {count}"
msgstr "Раскладки Plasma: {count}"

#: src/ntrcn/diagnostics.py:83
msgid "Add a second layout in System Settings → Keyboard → Layouts"
msgstr ""
"Добавьте вторую раскладку в Параметрах системы → Клавиатура → Раскладки"

#: src/ntrcn/distro.py:68
#, python-brace-format
msgid ""
"Install a hunspell dictionary for “{language}” with your package manager"
msgstr ""
"Установите словарь hunspell для языка «{language}» через менеджер пакетов"

#: src/ntrcn/distro.py:73
#, python-brace-format
msgid "Install the {package} package from the AUR"
msgstr "Установите пакет {package} из AUR"

#: src/ntrcn/download.py:80
#, python-brace-format
msgid "Could not download the dictionary: {error}"
msgstr "Не удалось скачать словарь: {error}"

#: src/ntrcn/download.py:84
msgid "Could not download the dictionary: the server sent something else"
msgstr "Не удалось скачать словарь: сервер прислал не словарь"

#: src/ntrcn/download.py:93
#, python-brace-format
msgid "Could not save the dictionary: {error}"
msgstr "Не удалось сохранить словарь: {error}"

