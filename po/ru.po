msgstr "Выбрать картинку…"

#: src/ntrcn/settings.py:356
msgid "Reset"
msgstr "Сбросить"

#: src/ntrcn/settings.py:366
#, python-brace-format
msgid "Picture for the {layout} layout"
msgstr "Картинка для раскладки {layout}"

#: src/ntrcn/settings.py:368
