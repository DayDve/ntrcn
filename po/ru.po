#, python-brace-format
msgid "Version {version}"
msgstr "Версия {version}"

#: src/ntrcn/settings.py:438
msgid ""
"Fixes text typed in the wrong keyboard layout on KDE Plasma 6 (Wayland)."
msgstr ""
"Исправление текста, набранного в неправильной раскладке, для KDE Plasma 6 "
"(Wayland)."

